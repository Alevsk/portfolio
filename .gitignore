# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.swp
*.orig

# Test binary, build with `go test -c`
*.test

.idea/
vendor/

dist/

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# dependencies
node_modules/
/.pnp
.pnp.js
.pnp.cjs
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# testing
coverage/

# production
build/

# misc
.DS_Store
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Ignore tls cert and key
private.key
public.crt
*.pem
*.key
*.crt

# Ignore VsCode files
.vscode/
*.code-workspace
*~
.eslintcache

# Playwright
.playwright-mcp/
playwright-report/
test-results/

# Secrets and credentials
*.secrets
credentials.json
secrets.json
